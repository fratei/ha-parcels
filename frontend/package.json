{
  "name": "parcels-cards",
  "version": "0.1.2",
  "private": true,
  "description": "Lovelace cards for the Parcels Home Assistant integration",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src tests",
    "test": "node --test tests/*.test.ts",
    "build": "esbuild src/index.ts --bundle --format=esm --target=es2022 --minify --legal-comments=eof --outfile=../custom_components/parcels/frontend/parcels-cards.js"
  },
  "dependencies": {
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "oxlint": "1.93.0",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "esbuild": false
  }
}
